[init]
	defaultBranch = main
[user]
	name = Hieu Cao
	email = hieu.cao@enotion.io
[core]
	ignorecase = false
	editor = code --wait
	excludesfile = /Users/fe-hieu/.gitignore_global
	autocrlf = true
[alias]
	adog = log --all --decorate --oneline --graph
	rank = shortlog -sn --no-merges
	last = log -1 HEAD --stat
	co = checkout
	st = status
	br = branch
	cm = commit -m
	rv = remote -v
	new = co -b
	del = br -D
	cp = cherry-pick
	subclone = submodule update --init
	subeach = submodule foreach
	subco = subeach git co
	subpull = subeach git pull -p
	forcebr = "!f() { git br -f $1 HEAD; }; f"
	squash = "!f() { git rebase -i HEAD~$1; }; f"
	sq = squash
	ours = "!f() { git co --ours $@ && git add $@; }; f"
	theirs = "!f() { git co --theirs $@ && git add $@; }; f"
	undo = reset --soft HEAD^
	back = reset --hard HEAD^
	rs = "!f() { git reset .; git clean -f .; git restore .; }; f"
	slist = stash list
	ssave = stash save
	sapply = stash apply
	spop = stash pop
	sdrop = stash drop
	sclear = stash clear
	parent = "!git show-branch | grep '*' | grep -v \"$(git rev-parse --abbrev-ref HEAD)\" | head -n1 | sed 's/.*\\[\\(.*\\)\\].*/\\1/' | sed 's/[\\^~].*//' #"

[mergetool]
	prompt = true
	keepBackup = false
    keepTemporaries = false
[difftool]
	prompt = true

[merge]
	tool = vscode
[diff]
	tool = vscode

[mergetool "vscode"]
	cmd = code --wait --merge $LOCAL $REMOTE $BASE $MERGED
[difftool "vscode"]
	cmd = code --wait --diff $LOCAL $REMOTE

[http]
	postBuffer = 524288000
	version = HTTP/2
[commit]
	template = /Users/user/.stCommitMsg
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[push]
	autoSetupRemote = true

[difftool "sourcetree"]
	cmd = opendiff \"$LOCAL\" \"$REMOTE\"
	path = 
[mergetool "sourcetree"]
	cmd = /Applications/Sourcetree.app/Contents/Resources/opendiff-w.sh \"$LOCAL\" \"$REMOTE\" -ancestor \"$BASE\" -merge \"$MERGED\"
	trustExitCode = true
[credential]
	helper = /usr/local/share/gcm-core/git-credential-manager
[credential "https://dev.azure.com"]
	useHttpPath = true
